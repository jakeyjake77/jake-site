---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const byDate = (a, b) => b.data.date.valueOf() - a.data.date.valueOf();
const notes = (await getCollection('notes')).sort(byDate);
const essays = (await getCollection('essays')).sort(byDate);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Jake">
  <h1>Jake</h1>

  <h2>Notes</h2>
  <ul>
    {notes.map((n) => <li><a href={`${base}/notes/${n.id}/`}>{n.data.title}</a></li>)}
  </ul>

  <h2>Essays</h2>
  <ul>
    {essays.map((e) => <li><a href={`${base}/essays/${e.id}/`}>{e.data.title}</a></li>)}
  </ul>
</Base>
